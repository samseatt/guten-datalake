# Required. Local Unix socket example; use your own database credentials on deployment.
DATABASE_URL=postgresql+asyncpg:///guten_datalake
LOG_LEVEL=INFO
SQL_ECHO=false
# Optional rotating file output. By default logs go to stderr for service supervision.
# LOG_FILE=logs/guten_datalake.log

# Docker uses DATABASE_URL_FILE=/run/secrets/database_url instead of DATABASE_URL.
# Configure exactly one source; never bake either secret into an image.
